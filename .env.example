# ──────────────────────────────────────────────────────────────
# VIRTUAL FIT — environment configuration
# Copy to .env and adjust. NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────

# Root directory for all persistent image storage.
# Local development default: ./.storage (auto-created, gitignored)
# Production (Docker): /data/storage (mounted volume)
STORAGE_ROOT=./.storage

# ── Database: Supabase (PostgreSQL) ──────────────────────────────────────
# One-time setup: paste prisma/supabase-setup.sql into the Supabase
# Dashboard -> SQL Editor and run it (creates schema + demo catalog).
# Then copy the connection URI here (Project Settings -> Database),
# replacing [YOUR-PASSWORD] and [REGION].
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Public Supabase API values (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Long random value used to sign customer sessions. Keep it secret.
AUTH_SECRET=replace-with-a-long-random-secret

# Public base URL of the app (used for absolute asset URLs if needed).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Body landmark detection model ────────────────────────────
# Pose model served to the browser. Defaults to a self-hosted copy
# in /public/models (fetched by `npm run postinstall`).
# Fallback: Google storage CDN (set if you do not want to self-host).
NEXT_PUBLIC_POSE_MODEL_URL=/models/pose_landmarker_lite.task

# ── AI assistant (OPTIONAL — the app fully works without it) ─
# Get a free key at https://openrouter.ai (free models exist).
# If unset, the deterministic local NLU engine handles commands.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated origin allowlist for the AI endpoint (empty = same origin)
AI_ALLOWED_ORIGINS=

# ── Admin panel ───────────────────────────────────────────────
# Set a long random secret. Used to sign the admin session cookie.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# ── Uploads & retention (hours) ───────────────────────────────
MAX_UPLOAD_MB=10
TEMP_TTL_HOURS=1
UPLOAD_TTL_HOURS=24
RESULT_TTL_HOURS=24

# ── Rate limiting ─────────────────────────────────────────────
AI_RATE_LIMIT_PER_MINUTE=12
UPLOAD_RATE_LIMIT_PER_MINUTE=20
