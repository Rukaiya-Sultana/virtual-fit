generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id               String   @id
  name             String
  description      String?
  price            Float
  stock            Int      @default(100)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  color            String
  colorHex         String
  fit              String
  sleeve           String
  styleJson        String
  occasionsJson    String
  formality        Int
  lengthFactor     Float
  assetPath        String
  originalPath     String
  thumbnailPath    String
  leftShoulderX    Float
  leftShoulderY    Float
  rightShoulderX   Float
  rightShoulderY   Float
  leftHemX         Float
  leftHemY         Float
  rightHemX        Float
  rightHemY        Float
  width            Int
  height           Int
  sizesJson        String?
  badge            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  total     Float
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  size      String
  price     Float
}
